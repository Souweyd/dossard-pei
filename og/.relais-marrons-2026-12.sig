["Le Relais des Marrons", "2026-12-20", "Sainte-Suzanne", [{"nom": "Relais des Marrons", "type": "relais", "h": "09h00", "prix": "13 €", "limite": "2026-12-16", "note": "Équipes de 7 (à partir de minime), 13 € par relayeur, soit 91 € par équipe. Arrivée à la stèle Edmond Albius. Dossards le jour même, de 6h30 à 8h00, à la mairie de Sainte-Suzanne."}], "posters/relais-marrons-2026-12.webp", "posters/relais-marrons-2026-12_lg.webp", "art1"]